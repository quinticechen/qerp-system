{
  "name": "weave-flow-mcp-server",
  "version": "1.0.0",
  "description": "MCP Server for Weave Flow ERP — 紡織業 ERP 自然語言操作介面",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "eval": "tsx --env-file=.env evals/run.ts",
    "eval:upload": "tsx --env-file=.env evals/langfuse.ts",
    "prompts": "tsx --env-file=.env evals/prompts-cli.ts",
    "judge": "tsx --env-file=.env evals/judge-calibration.ts",
    "typecheck:evals": "tsc -p evals --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@langfuse/client": "6.0.0",
    "@langfuse/otel": "6.0.0",
    "@langfuse/tracing": "6.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@openrouter/ai-sdk-provider": "^0.4.6",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/otlp-exporter-base": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@supabase/supabase-js": "^2.49.4",
    "ai": "^4.3.19",
    "express": "^5.2.1",
    "zod": "^3.25.30"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  }
}
